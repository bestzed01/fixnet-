nano .env# ── Telegram ──────────────────────────────────────────────── 
BOT_TOKEN=your_bot_token_here

# ── ngrok public URL (run: ngrok http 8000, copy the https URL) ── This is what goes into 
# BotFather as the Mini App URL
nano .envBACKEND_URL=https://xxxx.ngrok-free.app MINI_APP_URL=https://xxxx.ngrok-free.app/app

# ── Outline VPN (get after: sudo bash scripts/install_outline.sh) ──
# Looks like: https://1.2.3.4:12345/xxxxxxxxxxxxxxxxx
OUTLINE_API_URL=https://YOUR_SERVER_IP:PORT/SECRET

